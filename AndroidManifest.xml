<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pclogin">

    <!-- List the users, read their pictures and restrictions, add and remove users. -->
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.CREATE_USERS" />
    <!-- Bring the chosen user to the foreground. -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <!-- The accessibility button opens SystemUI's quick access dialog. -->
    <uses-permission
        android:name="com.android.systemui.permission.LAUNCH_ACCESSIBILITY_SHORTCUT_CHOOSER_DIALOG" />

    <application
        android:label="@string/app_name"
        android:directBootAware="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PcLogin">

        <!-- The home screen of the headless system user (user 0): etc/ installs this package
             there only. Priority above the launcher's, which user 0 also has. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter android:priority="4">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
