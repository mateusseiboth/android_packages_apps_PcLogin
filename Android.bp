// PcLogin: the login screen of LineageOS for PCs. It is the home screen of the headless system user
// (user 0): it lists the people who use the PC, signs one in, and adds users and guests.
// The screen's logic lives in core/ and is tested on the host.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "PcLoginCore",
    host_supported: true,
    srcs: ["core/src/**/*.kt"],
    sdk_version: "core_current",
}

java_test_host {
    name: "PcLoginCoreTests",
    srcs: ["core/tests/**/*.kt"],
    static_libs: [
        "PcLoginCore",
        "junit",
    ],
    test_options: {
        unit_test: true,
    },
}

android_app {
    name: "PcLogin",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "PcLoginCore",
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.animation_animation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "kotlinx_coroutines_android",
    ],
    optimize: {
        optimize: true,
        shrink_resources: true,
    },
    required: [
        "privapp-permissions-pclogin.xml",
        "preinstalled-packages-pclogin.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-pclogin.xml",
    src: "etc/privapp-permissions-pclogin.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

// Installs PcLogin for the headless system user only: the people who use the PC never see it.
prebuilt_etc {
    name: "preinstalled-packages-pclogin.xml",
    src: "etc/preinstalled-packages-pclogin.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}
